# ──────────────────────────────────────────────────────────
# DSA Mission Control — environment variables
# Copy this to `.env` for local dev, or set in Vercel for production.
# ──────────────────────────────────────────────────────────

# Local dev: point at the SQLite file in prisma/
DATABASE_URL="file:./dev.db"

# Production (Vercel): Turso libSQL connection
# Get these from https://turso.tech after creating a database.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-token-here"

# Optional: protect the deployed app with a shared password.
# Leave empty to disable. Anyone hitting any page is prompted once
# and a cookie remembers them.
APP_PASSWORD="set-a-password-here"
