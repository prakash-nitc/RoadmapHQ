    "deploy:import": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/import-turso.ts",
    "fix:urls": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/fix-problem-urls.ts"
  },
